[MASTER]
ignore=migrations,env,media,static,__pycache__

[MESSAGES CONTROL]
disable=
    import-error, relative-beyond-top-level, no-name-in-module,
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    C0303,
    C0304,
    C0305,
    C0415,
    C0413,
    C0412,
    C0411,
    W0404,
    R0915,
    R0912,
    R0914,
    W0612,
    W0611,
    R1705,
    E0307,
    R0901,
    R0903,
    W0702,
    W0718,
    C0103,
    C0301,
    E1101

[FORMAT]
max-line-length=200